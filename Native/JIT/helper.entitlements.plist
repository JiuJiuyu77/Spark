<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- ==================================================================
	     Spark Helper (bin/spark-jitd) 专用 entitlements
	     必须与主 App 分开签名：Helper 是独立进程，
	     继承不到主 App 的签名权限。
	     ================================================================== -->

	<!-- 平台身份：能以 root 起、不受沙盒限制 -->
	<key>platform-application</key>
	<true/>
	<key>com.apple.private.security.no-sandbox</key>
	<true/>
	<key>com.apple.private.security.container-required</key>
	<false/>
	<key>com.apple.private.security.no-container</key>
	<true/>

	<!-- 最关键：让 make/clang/ldid 等孙进程继承豁免 -->
	<key>com.apple.private.security.storage-exempt.heritable</key>
	<true/>
	<key>com.apple.private.security.storage.AppBundles</key>
	<true/>
	<key>com.apple.private.security.storage.AppDataContainers</key>
	<true/>

	<!-- 以 root 身份 spawn -->
	<key>com.apple.private.persona-mgmt</key>
	<true/>

	<!-- 查容器（需要知道目标 App 装在哪） -->
	<key>com.apple.private.MobileContainerManager.allowed</key>
	<true/>
	<key>com.apple.private.MobileContainerManager.lookup</key>
	<true/>

	<!-- iOS 16+ 开发者模式 -->
	<key>com.apple.private.amfi.developer-mode-control</key>
	<true/>

	<!-- 执行可执行内存（JIT） -->
	<key>com.apple.private.cs.allow-jit</key>
	<true/>
	<key>com.apple.security.cs.allow-jit</key>
	<true/>
	<key>com.apple.security.cs.allow-unsigned-executable-memory</key>
	<true/>

	<!-- 全盘读写 -->
	<key>com.apple.security.exception.files.absolute-path.read-write</key>
	<array>
		<string>/</string>
	</array>

	<!-- 进程管理 -->
	<key>task_for_pid-allow</key>
	<true/>

	<!-- 注意：以下三项绝对不能加，A12+ / iOS 15+ 会让 Helper 起不来
	     dynamic-codesigning
	     com.apple.private.cs.debugger
	     com.apple.private.skip-library-validation
	-->
</dict>
</plist>
